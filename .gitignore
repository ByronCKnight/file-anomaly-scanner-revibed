# =========================================================================
# File Anomaly Scanner - Git Ignore Rules
# =========================================================================

# --- Visual Studio & IDE Caches ---
.vs/
**/.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
.vscode/

# --- .NET Build Outputs & Debug Symbols ---
bin/
obj/
**/[Bb]in/
**/[Oo]bj/
*.pdb
*.deps.json
*.runtimeconfig.json

# --- WebView2 User Profile & Browser Cache Folders ---
*.WebView2/
**/*.WebView2/
EBWebView/
**/EBWebView/

# --- Frontend / Node ---
**/node_modules/
**/dist/
.env
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Operating System Files ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# --- Security & Local Configuration (Never Commit API Keys or Local Secrets) ---
**/security-settings*.json
security-settings.json
appsettings.user.json
appsettings.Development.json
appsettings.Production.json
appsettings.local.json
appsettings.*.local.json
*.local.json
*.key
*.pem
*.pfx
*.cer
*.crt

# --- Template Whitelists (Allow Example Config Templates) ---
!**/appsettings.Example.json
!**/security-settings.example.json
!appsettings.Example.json
!security-settings.example.json

# --- Allow the 1-Click Desktop Launcher Executable in the Root ---
!/FileAnomalyScanner.exe
